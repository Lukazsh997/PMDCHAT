# ============================================================================
# Plataforma de Comunicação Interna — variáveis de ambiente
# Copie para .env e ajuste. Nunca versione o arquivo .env.
# ============================================================================

# Nome da organização exibido na tela de login
ORG_NAME="Comunicação Interna"
APP_VERSION=0.1.0

# Endereço principal do sistema, sem barra no final. O login funciona por qualquer
# endereço da VM (nome, IP ou porta); liste aqui origens extras separadas por vírgula.
# (http://localhost:5173 é o servidor de desenvolvimento.)
APP_ORIGINS=http://chat.orgao.local,http://localhost:5173

# Portas publicadas pelo Nginx na VM. O HTTPS liga quando há certificado em
# infra/nginx/certs (infra/scripts/https.sh); sem ele, o site fica em HTTP.
HTTP_PORT=80
HTTPS_PORT=443

# ---- Banco de dados (PostgreSQL) -------------------------------------------
# No Docker Compose a URL é montada a partir de POSTGRES_*; DATABASE_URL e
# REDIS_URL abaixo valem para o desenvolvimento local.
POSTGRES_DB=plataforma
POSTGRES_USER=plataforma
POSTGRES_PASSWORD=troque-esta-senha
DATABASE_URL=postgres://plataforma:troque-esta-senha@localhost:5432/plataforma

# ---- Valkey (sessões, filas, limites de requisição) ------------------------
REDIS_URL=redis://localhost:6379/0

# ---- Sessões e login --------------------------------------------------------
# true com HTTPS (o infra/scripts/https.sh ajusta sozinho). Com true, o login só
# funciona por https://.
COOKIE_SECURE=false
SESSION_IDLE_MINUTES=480
SESSION_MAX_HOURS=72
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
LOGIN_RATE_LIMIT_PER_MINUTE=10
API_RATE_LIMIT_PER_MINUTE=600

# ---- Segurança -------------------------------------------------------------
# Chave para cifrar dados sensíveis no banco (segredos da verificação em duas
# etapas). O install.sh gera uma aleatória. Não troque depois de instalado.
APP_SECRET=troque-por-uma-chave-aleatoria-de-64-caracteres-0000000000000000
# Exigir verificação em duas etapas de quem acessa o painel administrativo.
MFA_REQUIRED_FOR_ADMINS=true

# ---- Anexos e antivírus -----------------------------------------------------
# O ClamAV roda como o serviço "clamav" (perfil "antivirus"). Para desativar o
# antivírus, deixe COMPOSE_PROFILES vazio e CLAMAV_HOST= (vazio).
COMPOSE_PROFILES=antivirus
CLAMAV_HOST=clamav
CLAMAV_REQUIRED=true
# Desenvolvimento local: pasta dos anexos (no Docker é o volume filesdata).
FILES_DIR=./data/files

# ---- Administrador inicial (criado só se o banco estiver vazio) -------------
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=TroqueNoPrimeiroAcesso2026

# ---- Aplicação --------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=info
TRUST_PROXY_HOPS=1

# Web Push: avisos com a aba do sistema fechada (Chrome aberto). Usa o serviço de push
# do Google, então a VM precisa sair para a internet (fcm.googleapis.com, porta 443).
# PUSH_SUBJECT: contato da organização exigido pelo protocolo (mailto: ou https:).
# PUSH_PROXY: preencha só se a VM sair para a internet por um proxy (ex.: http://proxy:3128).
PUSH_ENABLED=true
PUSH_SUBJECT=mailto:suporte@plataforma.local
PUSH_PROXY=

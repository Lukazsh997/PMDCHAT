{
  "name": "@plataforma/api",
  "version": "0.1.0",
  "private": true,
  "description": "API HTTP + WebSocket e worker da plataforma (NestJS sobre Fastify)",
  "type": "module",
  "files": [
    "dist",
    "drizzle"
  ],
  "scripts": {
    "build": "swc src -d dist --strip-leading-paths --config-file .swcrc --ignore '**/*.test.ts'",
    "dev": "node --watch --env-file-if-exists=../../.env --import @swc-node/register/esm-register src/main.ts",
    "dev:worker": "node --watch --env-file-if-exists=../../.env --import @swc-node/register/esm-register src/worker.ts",
    "start": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "cli": "node dist/cli.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=../../.env --import @swc-node/register/esm-register src/cli.ts migrate"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/helmet": "^13.2.0",
    "@fastify/multipart": "^10.1.7",
    "@fastify/rate-limit": "^11.2.2",
    "@nestjs/common": "^12.3.2",
    "@nestjs/core": "^12.3.2",
    "@nestjs/platform-fastify": "^12.3.2",
    "@node-rs/argon2": "^2.2.2",
    "@plataforma/contracts": "workspace:*",
    "@socket.io/redis-adapter": "^8.3.0",
    "bullmq": "^6.5.4",
    "drizzle-orm": "^0.45.4",
    "fastify": "5.12.7",
    "file-type": "^22.3.0",
    "ioredis": "^6.0.0",
    "otpauth": "^9.6.0",
    "postgres": "^4.0.0",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.5",
    "socket.io": "^4.8.4",
    "uuidv7": "^1.2.1",
    "web-push": "3.6.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "^12.3.2",
    "@swc-node/register": "^1.12.1",
    "@swc/cli": "^0.8.2",
    "@swc/core": "^1.16.21",
    "@types/node": "^24.19.2",
    "@types/qrcode": "^1.5.6",
    "@types/web-push": "3.6.4",
    "drizzle-kit": "^0.31.11",
    "socket.io-client": "^4.8.4",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.1.0"
  }
}
